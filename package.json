{
	"name": "broadcast",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"commit": "cz",
		"lint:prettier:check": "prettier --check web/src functions/src",
		"lint:prettier:fix": "prettier --write web/src functions/src",
		"lint:eslint:check": "eslint --config eslint.config.cjs web/src functions/src --max-warnings=0"
	},
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@commitlint/cli": "19.4.0",
		"@commitlint/config-conventional": "21.2.2",
		"@typescript-eslint/eslint-plugin": "^8.71.0",
		"@typescript-eslint/parser": "^8.71.0",
		"commitizen": "4.3.2",
		"cz-conventional-changelog": "3.3.0",
		"eslint": "^10.9.1",
		"prettier": "3.9.9"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	}
}
